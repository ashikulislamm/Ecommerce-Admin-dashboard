{
  "openapi": "3.0.3",
  "info": {
    "title": "Enterprise Ecommerce Admin Dashboard API",
    "version": "1.0.0",
    "description": "Exhaustive REST API specification for the Enterprise Ecommerce Admin Dashboard backend."
  },
  "servers": [
    {
      "url": "http://localhost:8080/api/v1",
      "description": "Local Development Server"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      },
      "cookieAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "refreshToken"
      }
    }
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health Check",
        "responses": { "200": { "description": "Healthy" }, "503": { "description": "Database disconnected" } }
      }
    },
    "/auth/login": {
      "post": {
        "summary": "Login user",
        "responses": { "200": { "description": "Login successful" }, "401": { "description": "Invalid credentials" } }
      }
    },
    "/auth/refresh": {
      "post": {
        "summary": "Refresh access token",
        "security": [{ "cookieAuth": [] }],
        "responses": { "200": { "description": "Token refreshed" } }
      }
    },
    "/auth/logout": {
      "post": {
        "summary": "Logout user",
        "responses": { "200": { "description": "Logged out" } }
      }
    },
    "/auth/session": {
      "get": {
        "summary": "Get session user",
        "security": [{ "bearerAuth": [] }],
        "responses": { "200": { "description": "Session restored" } }
      }
    },
    "/users": {
      "get": {
        "summary": "List users",
        "security": [{ "bearerAuth": [] }],
        "responses": { "200": { "description": "Users list" } }
      },
      "post": {
        "summary": "Create user",
        "security": [{ "bearerAuth": [] }],
        "responses": { "201": { "description": "User created" } }
      }
    },
    "/users/{id}": {
      "get": { "summary": "Get user by ID", "security": [{ "bearerAuth": [] }], "responses": { "200": { "description": "User details" } } },
      "patch": { "summary": "Update user profile", "security": [{ "bearerAuth": [] }], "responses": { "200": { "description": "User updated" } } },
      "delete": { "summary": "Delete user", "security": [{ "bearerAuth": [] }], "responses": { "200": { "description": "User deleted" } } }
    },
    "/users/{id}/role": {
      "patch": { "summary": "Update user role", "security": [{ "bearerAuth": [] }], "responses": { "200": { "description": "Role updated" } } }
    },
    "/users/{id}/status": {
      "patch": { "summary": "Update user status", "security": [{ "bearerAuth": [] }], "responses": { "200": { "description": "Status updated" } } }
    },
    "/roles": {
      "get": { "summary": "List roles", "security": [{ "bearerAuth": [] }], "responses": { "200": { "description": "Roles list" } } },
      "post": { "summary": "Create role", "security": [{ "bearerAuth": [] }], "responses": { "201": { "description": "Role created" } } }
    },
    "/roles/{id}": {
      "get": { "summary": "Get role by ID", "security": [{ "bearerAuth": [] }], "responses": { "200": { "description": "Role details" } } },
      "patch": { "summary": "Update role", "security": [{ "bearerAuth": [] }], "responses": { "200": { "description": "Role updated" } } },
      "delete": { "summary": "Delete role", "security": [{ "bearerAuth": [] }], "responses": { "200": { "description": "Role deleted" } } }
    },
    "/roles/{id}/permissions": {
      "post": { "summary": "Assign permission to role", "security": [{ "bearerAuth": [] }], "responses": { "200": { "description": "Permission assigned" } } }
    },
    "/roles/{id}/permissions/{permissionId}": {
      "delete": { "summary": "Revoke permission from role", "security": [{ "bearerAuth": [] }], "responses": { "200": { "description": "Permission revoked" } } }
    },
    "/roles/{id}/permissions/grant-all": {
      "post": { "summary": "Grant all permissions to role", "security": [{ "bearerAuth": [] }], "responses": { "200": { "description": "All permissions granted" } } }
    },
    "/permissions": {
      "get": { "summary": "List permissions", "security": [{ "bearerAuth": [] }], "responses": { "200": { "description": "Permissions list" } } },
      "post": { "summary": "Create permission", "security": [{ "bearerAuth": [] }], "responses": { "201": { "description": "Permission created" } } }
    },
    "/permissions/groups": {
      "get": { "summary": "List permission groups", "security": [{ "bearerAuth": [] }], "responses": { "200": { "description": "Permission groups" } } },
      "post": { "summary": "Create permission group", "security": [{ "bearerAuth": [] }], "responses": { "201": { "description": "Permission group created" } } }
    },
    "/media/upload": {
      "post": { "summary": "Upload single file", "security": [{ "bearerAuth": [] }], "responses": { "201": { "description": "File uploaded" } } }
    },
    "/media/upload-multiple": {
      "post": { "summary": "Upload multiple files", "security": [{ "bearerAuth": [] }], "responses": { "201": { "description": "Files uploaded" } } }
    },
    "/media": {
      "get": { "summary": "List media files", "security": [{ "bearerAuth": [] }], "responses": { "200": { "description": "Media list" } } }
    },
    "/media-folders/tree": {
      "get": { "summary": "Get folder tree", "security": [{ "bearerAuth": [] }], "responses": { "200": { "description": "Folder tree" } } }
    },
    "/media-folders/move-media": {
      "post": { "summary": "Move media to folder", "security": [{ "bearerAuth": [] }], "responses": { "200": { "description": "Media moved" } } }
    },
    "/categories/tree": {
      "get": { "summary": "Get category tree", "security": [{ "bearerAuth": [] }], "responses": { "200": { "description": "Category tree" } } }
    },
    "/categories": {
      "get": { "summary": "List categories", "security": [{ "bearerAuth": [] }], "responses": { "200": { "description": "Categories list" } } },
      "post": { "summary": "Create category", "security": [{ "bearerAuth": [] }], "responses": { "201": { "description": "Category created" } } }
    },
    "/brands": {
      "get": { "summary": "List brands", "security": [{ "bearerAuth": [] }], "responses": { "200": { "description": "Brands list" } } },
      "post": { "summary": "Create brand", "security": [{ "bearerAuth": [] }], "responses": { "201": { "description": "Brand created" } } }
    },
    "/attributes": {
      "get": { "summary": "List attributes", "security": [{ "bearerAuth": [] }], "responses": { "200": { "description": "Attributes list" } } },
      "post": { "summary": "Create attribute", "security": [{ "bearerAuth": [] }], "responses": { "201": { "description": "Attribute created" } } }
    },
    "/products": {
      "get": { "summary": "List products", "security": [{ "bearerAuth": [] }], "responses": { "200": { "description": "Products list" } } }
    },
    "/products/simple": {
      "post": { "summary": "Create simple product", "security": [{ "bearerAuth": [] }], "responses": { "201": { "description": "Simple product created" } } }
    },
    "/products/variable": {
      "post": { "summary": "Create variable product", "security": [{ "bearerAuth": [] }], "responses": { "201": { "description": "Variable product created" } } }
    },
    "/products/generate-matrix": {
      "post": { "summary": "Generate matrix variants", "security": [{ "bearerAuth": [] }], "responses": { "200": { "description": "Matrix variants generated" } } }
    }
  }
}
